)]\n    best_g, parent, closed = {start: 0.0}, {start: None}, set()\n    expanded = 0\n    while open_heap:\n        f, g, node = heapq.heappop(open_heap)\n        if node in closed:\n            continue\n        if node == goal:\n            path = []\n            while node is not None:\n                path.append(node); node = parent[node]\n            return path[::-1], expanded\n        closed.add(node)\n        expanded += 1\n        if log is not None: log.append(node)\n        for nxt, w in adj[node].items():\n            new_g = g + w\n            if new_g < best_g.get(nxt, math.inf):\n                best_g[nxt] = new_g\n                parent[nxt] = node\n                heapq.heappush(open_heap, (new_g + haversine(nxt, goal), new_g, nxt))\n    return None, expanded\n\ndef astar_hops(start, goal, log=None):\n    \"\"\"A* where every flight costs 1 (same objective as BFS).\n    h = ceil(straight-line km / longest route in the data): never overestimates.\"\"\"\n    h = lambda n: math.ceil(haversine(n, goal) / MAX_EDGE_KM - 1e-9)\n    open_heap = [(h(start), 0, start)]\n    best_g, parent, closed = {start: 0}, {start: None}, set()\n    expanded = 0\n    while open_heap:\n        f, g, node = heapq.heappop(open_heap)\n        if node in closed:\n            continue\n        if node == goal:\n            path = []\n            while node is not None:\n                path.append(node); node = parent[node]\n            return path[::-1], expanded\n        closed.add(node)\n        expanded += 1\n        if log is not None: log.append(node)\n        for nxt in adj[node]:\n            if g + 1 < best_g.get(nxt, math.inf):\n                best_g[nxt] = g + 1\n                parent[nxt] = node\n                heapq.heappush(open_heap, (g + 1 + h(nxt), g + 1, nxt))\n    return None, expanded\n\n# Ground truth (only used to check the answers above)\ndef bfs_ref(start, goal):\n    q, parent = deque([start]), {start: None}\n    while q:\n        u = q.popleft()\n        if u == goal:\n            path = []\n            while u is not None:\n                path.append(u); u = parent[u]\n            return path[::-1], 0\n        for v in adj[u]:\n            if v not in parent:\n                parent[v] = u; q.append(v)\n    return None, 0\n\ndef dijkstra_ref(start, goal):\n    heap, best, parent, done = [(0.0, start)], {start: 0.0}, {start: None}, set()\n    while heap:\n        g, u = heapq.heappop(heap)\n        if u in done:\n            continue\n        if u == goal:\n            path = []\n            while u is not None:\n                path.append(u); u = parent[u]\n            return path[::-1], 0\n        done.add(u)\n        for v, w in adj[u].items():\n            if g + w < best.get(v, math.inf):\n                best[v] = g + w; parent[v] = u\n                heapq.heappush(heap, (g + w, v))\n    return None, 0\n\nALGOS = {\"BiBFS (hops)\": bidirectional_bfs, \"A* (km)\": astar, \"A* (hops)\": astar_hops}\n\ndef band(km):\n    return \"short (<1500 km)\" if km < 1500 else \"medium (1500-5000 km)\" if km < 5000 else \"long (>5000 km)\"\n\ndef run_benchmark(n_pairs=1000, seed=42, mem_pairs=100):\n    rng = random.Random(seed)\n    ids = list(airports.index)\n    pairs = [tuple(rng.sample(ids, 2)) for _ in range(n_pairs)]\n    rows = []\n    for i, (s, t) in enumerate(pairs):\n        ref_h, _ = bfs_ref(s, t)\n        reachable = ref_h is not None\n        if reachable:\n            opt_h = len(ref_h) - 1\n            opt_k = path_km(dijkstra_ref(s, t)[0])\n        straight = haversine(s, t)\n        for name, fn in ALGOS.items():\n            t0 = time.perf_counter()\n            path, exp = fn(s, t)\n            ms = (time.perf_counter() - t0) * 1000\n            row = dict(pair=i, src=id_to_code[s], dst=id_to_code[t], algo=name,\n                       straight_km=straight, band=band(straight),\n                       reachable=reachable, found=path is not None,\n                       expanded=exp, time_ms=